# Copy to app/.env before `npm run build`. Production builds ignore URL settings, so these values
# decide which factory, RPC and chain the app trusts.
VITE_APP_NAME=PotLoop

# QIE mainnet DEMO factory (hackathon deployment, 23 Nov 2026). Demo rules: 60 s minimum rounds,
# 30 s grace, 0.01 QUSDC minimum, 0% minimum cover, 0.5% fee to a test treasury whose key was
# exposed. Fine for demonstrations; do not use it for real savings groups
# (see PRODUCTION_FACTORY_RECOMMENDATION.md).
VITE_FACTORY_ADDRESS=0xD099c7361157Ec20a9Ac145aF4B66Af553AeDae4
# block the factory was deployed in (makes history load faster)
VITE_FROM_BLOCK=12109975

# rpc1 was slow on 23 Nov 2026; rpc3mainnet.qie.digital answered reliably that day
VITE_RPC_URL=https://rpc1mainnet.qie.digital
VITE_CHAIN_ID=1990
VITE_EXPLORER=https://mainnet.qie.digital
VITE_DEX_URL=https://www.dex.qie.digital/#/swap
