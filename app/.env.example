# Copy to app/.env before `npm run build`. Production builds ignore URL settings, so these values
# decide which factories, RPC and chain the app trusts.
VITE_APP_NAME=PotLoop

# QIE mainnet PRODUCTION factory (deployed 24 Nov 2026, source verified): new circles are created
# here. Rules fixed forever: rounds of at least 1 day, grace at least 6 hours, at least 1 QUSDC per
# round, 100% cover required, no fee and no treasury.
VITE_FACTORY_ADDRESS=0xE1ea943b865F47e984156526add5E07B03893834
# block the factory was deployed in (makes history load faster)
VITE_FROM_BLOCK=12132174

# Earlier factories whose circles still open, marked "Test circle": address@deployment block.
# The testing factory (23 Nov 2026): 60 s rounds, 0% minimum cover, 0.5% fee to a test treasury
# whose key was exposed. It ran the 7 mainnet test circles S1-S7.
VITE_EARLIER_FACTORIES=0xD099c7361157Ec20a9Ac145aF4B66Af553AeDae4@12109975

# rpc1 was slow on 23 Nov 2026; rpc3mainnet.qie.digital answered reliably
VITE_RPC_URL=https://rpc3mainnet.qie.digital
VITE_CHAIN_ID=1990
VITE_EXPLORER=https://mainnet.qie.digital
VITE_DEX_URL=https://www.dex.qie.digital/#/swap
